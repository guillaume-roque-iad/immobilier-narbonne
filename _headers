/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: SAMEORIGIN

  # Même principe que Tribu Immo : on protège l'encapsulation du site lui-même
  # sans bloquer les iframes externes nécessaires au lecteur Propertips / YouTube.
  Content-Security-Policy: frame-ancestors 'self'

  # Politique complète en observation uniquement afin de détecter les écarts
  # sans casser les formulaires, Analytics ou le lecteur vidéo.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google-analytics.com https://images.iadfrance.fr; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://*.google-analytics.com https://*.analytics.google.com https://cloudflareinsights.com; frame-src 'self' https://www.youtube-nocookie.com; form-action 'self' https://script.google.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# Les scripts qui pilotent Propertips doivent toujours être revalidés afin
# d'éviter qu'un ancien comportement reste en cache dans Safari.
/navigation.js
  Cache-Control: no-cache, must-revalidate

/propertips.js
  Cache-Control: no-cache, must-revalidate

/propertips-media.js
  Cache-Control: no-cache, must-revalidate

# Le catalogue IAD et son moteur d'affichage doivent être revalidés à chaque visite.
# Cela évite qu'un changement de prix, de statut, de commune ou de typologie reste
# masqué derrière une ancienne version en cache.
/annonces.js
  Cache-Control: no-cache, must-revalidate

/annonces-iad.json
  Cache-Control: no-cache, must-revalidate

# Cache long pour les ressources statiques versionnables (polices, images, favicon).
# Ne s'applique jamais aux pages HTML (celles-ci restent sans cache long, cf. regle /* ci-dessus
# qui ne definit pas Cache-Control : Cloudflare applique alors son cache par defaut pour le HTML).
# NB : ces fichiers ne sont pas encore versionnes/hashes dans leur nom — si Guillaume remplace une
# image (ex. portrait), le nom de fichier devra changer pour forcer le rafraichissement du cache
# (sinon l'ancienne version peut rester servie jusqu'a un an). Voir rapport pour le detail.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.avif
  Cache-Control: public, max-age=31536000, immutable

/llms.txt
  Content-Type: text/plain; charset=utf-8
